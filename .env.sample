# Your own Anthropic API key — get one at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# The shared Salesforce org. These four values are handed out in the session.
# Never commit real values to a public repo.
SF_MY_DOMAIN=https://YOUR-ORG.my.salesforce.com
SF_AGENT_ID=0Xx0000000000000
SF_CONSUMER_KEY=3MVG9your-consumer-key
SF_CONSUMER_SECRET=your-consumer-secret

# Your Slack user token, the xoxp- one. Slack search runs through Slack's MCP
# server, which rejects bot tokens - without this the agent has no search tools
# and will not tell you. Read it from your app: Settings > Install App.
SLACK_USER_TOKEN=

# Step 5 only: the internal channel the resolution card is posted to.
# Leave blank and the card is posted in the customer's thread instead.
REP_CHANNEL=
